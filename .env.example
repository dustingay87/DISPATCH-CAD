# App secrets
SECRET_KEY=change-me-to-a-long-random-string

# Database - defaults to SQLite if not set
DATABASE_URL=sqlite:///./volcad.db

# Supabase credentials (optional)
SUPABASE_URL=https://dcxwpxongkkovgdtcsvr.supabase.co
SUPABASE_SERVICE_KEY=
# Optional: direct Postgres connection string from Supabase Settings > Database
SUPABASE_DB_URL=

# Timezone (IANA name, e.g. America/Chicago, America/New_York, UTC)
DEFAULT_TIMEZONE=America/Chicago

# Dev mode: true = non-secure cookies, easier local testing
# Set to false in production
INSECURE_DEV=true

# TAIP stale/offline thresholds (seconds)
TAIP_STALE_SECONDS=60
TAIP_OFFLINE_SECONDS=300
